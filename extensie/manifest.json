{
  "manifest_version": 3,
  "name": "Ploeggenoten CRM — Lead-knop",
  "version": "1.0.0",
  "description": "Voeg LinkedIn- en Sales Navigator-profielen of bedrijven met één klik toe aan het Ploeggenoten CRM als kandidaat-lead of sales-lead.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://gyhrwjdlwamyjhxtdypw.supabase.co/*",
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ploeggenoten CRM — inloggen / status"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
